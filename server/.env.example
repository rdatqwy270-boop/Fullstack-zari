# پورت سرور بک‌اند
PORT=4000

# آدرس فرانت‌اند مجاز برای CORS (در production دامنه واقعی را بگذارید)
# در حالت توسعه، Vite درخواست‌های /api را پروکسی می‌کند و نیازی به CORS نیست.
CORS_ORIGIN=http://localhost:5173

# هزینه ارسال به تومان (ارسال رایگان بالای این مبلغ)
SHIPPING_FEE=50000
FREE_SHIPPING_THRESHOLD=3000000
